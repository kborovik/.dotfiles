# bash env — for non-interactive bash (Grok/Claude agent tools, BASH_ENV).
# Mirror of zshenv / fish config.fish PATH order: Homebrew + keg-only first.
#
# Activate for non-interactive bash:
#   export BASH_ENV="$HOME/.dotfiles/bashenv"
# (or symlink/copy into a location your agent already sources)

# shellcheck disable=SC2123
PATH="/opt/homebrew/opt/make/libexec/gnubin:/opt/homebrew/opt/postgresql@18/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${HOME}/.local/bin:${HOME}/go/bin:${HOME}/.grok/bin:${PATH}"
export PATH
export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
