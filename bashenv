# bash env — for non-interactive bash (Grok/Claude agent tools, BASH_ENV).
# PATH lives in pathenv (shared with zsh). This file only wires bash activation.
#
# Installed as ~/.bashenv via `make base`. Activated when the parent shell
# exports BASH_ENV (fish config.fish + zshenv set this for all invocations).

# shellcheck source=pathenv
. "${HOME}/.pathenv"

# Nested bash (scripts that spawn bash -c) keeps the same env file.
export BASH_ENV="${BASH_ENV:-$HOME/.bashenv}"
