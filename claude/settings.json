{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "sdd@spec-driven-dev": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "pydantic-skills": {
      "source": {
        "source": "github",
        "repo": "pydantic/skills"
      },
      "autoUpdate": true
    },
    "spec-driven-dev": {
      "source": {
        "source": "github",
        "repo": "kborovik/spec-driven-dev"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "autoUpdatesChannel": "latest"
}
