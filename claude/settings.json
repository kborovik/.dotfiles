{
  "agentPushNotifEnabled" : true,
  "editorMode" : "vim",
  "effortLevel" : "xhigh",
  "enabledPlugins" : {
    "sdd@spec-driven-dev" : true,
    "skill-creator@claude-plugins-official" : true
  },
  "enableWorkflows" : true,
  "extraKnownMarketplaces" : {

  },
  "fileCheckpointingEnabled" : false,
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "osascript -e 'display notification \"Job done\" with title \"Claude Code\" sound name \"Glass\"'",
