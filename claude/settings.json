          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/kb\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ]
