# Shared brew-first PATH for non-interactive agent shells (bash + zsh).
# Sourced by bashenv (via BASH_ENV) and zshenv (always for every zsh).
# Mirror of fish config.fish fish_add_path order (first = highest priority).
#
# Installed as ~/.pathenv via `make base`. Do not export BASH_ENV here —
# leave that to bashenv so pure PATH consumers stay shell-neutral.

# shellcheck disable=SC2123
PATH="\
${HOME}/.claude/local:\
${HOME}/.grok/bin:\
${HOME}/go/bin:\
${HOME}/.cargo/bin:\
${HOME}/.local/bin:\
${HOME}/.opencode/bin:\
${HOME}/.bun/bin:\
${HOME}/.npm-global/bin:\
/opt/homebrew/opt/make/libexec/gnubin:\
/opt/homebrew/opt/postgresql@18/bin:\
${HOME}/Library/pnpm:\
${HOME}/Library/pnpm/bin:\
/opt/homebrew/bin:\
/opt/homebrew/sbin:\
${PATH}"
export PATH
export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
